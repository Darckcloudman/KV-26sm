# Test environment for Kola Wind Farm integration tests
USE_DATABASE=true
DB_HOST=localhost
DB_PORT=5432
DB_NAME=vibrodiag_test_kola
DB_USER=postgres
DB_PASSWORD=postgres
DB_POOL_SIZE=5
DB_ECHO=false
DB_CONNECT_RETRIES=3
DB_CONNECT_RETRY_DELAY=1.0

LOG_LEVEL=DEBUG

# Storage paths
ARCHIVE_STORAGE_PATH=./test_data

# Auto-scan settings
AUTO_SCAN_ENABLED=true
AUTO_SCAN_INTERVAL_MINUTES=10
AUTO_SCAN_MAX_DEPTH=5
